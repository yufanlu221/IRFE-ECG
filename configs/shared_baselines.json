{
  "description": "Shared-parameter continual-learning baselines",
  "seeds": [42, 43, 44],
  "prepare_feature_cache": false,
  "environment": {
    "ECG_DATA_DIR": "data/processed",
    "ECG_CKPT_PATH": "checkpoints/1_lead_ECGFounder.pth",
    "ECG_EPOCHS": "30",
    "ECG_BATCH_SIZE": "16",
    "ECG_LR": "0.0001",
    "ECG_WEIGHT_DECAY": "0.0001",
    "ECG_LOSS": "balanced_softmax",
    "ECG_CLASS_WEIGHT_MODE": "domain",
    "ECG_SELECT_CALIBRATED_EPOCH": "1",
    "ECG_VALIDATE_EVERY": "1",
    "ECG_SAVE_PARTIAL": "1",
    "ECG_NUM_WORKERS": "0",
    "ECG_CPU_THREADS": "4",
    "ECG_EWC_LAMBDA": "10",
    "ECG_EWC_MAX_BATCHES": "50",
    "ECG_LWF_LAMBDA": "1.0",
    "ECG_LWF_TEMPERATURE": "2.0",
    "ECG_REPLAY_PER_DOMAIN": "256"
  },
  "jobs": [
    {"name": "shared_head", "module": "trainer.shared_baselines", "output": "baseline_linear_probe_seed{seed}_{tag}", "environment": {"ECG_BASELINE_METHOD": "linear_probe"}},
    {"name": "full_finetune", "module": "trainer.shared_baselines", "output": "baseline_full_finetune_seed{seed}_{tag}", "environment": {"ECG_BASELINE_METHOD": "full_finetune"}},
    {"name": "ewc", "module": "trainer.shared_baselines", "output": "baseline_ewc_seed{seed}_{tag}", "environment": {"ECG_BASELINE_METHOD": "ewc"}},
    {"name": "lwf", "module": "trainer.shared_baselines", "output": "baseline_lwf_seed{seed}_{tag}", "environment": {"ECG_BASELINE_METHOD": "lwf"}},
    {"name": "si", "module": "trainer.shared_baselines", "output": "baseline_si_seed{seed}_{tag}", "environment": {"ECG_BASELINE_METHOD": "si"}},
    {"name": "small_replay", "module": "trainer.shared_baselines", "output": "baseline_small_replay_seed{seed}_{tag}", "environment": {"ECG_BASELINE_METHOD": "small_replay"}}
  ]
}
